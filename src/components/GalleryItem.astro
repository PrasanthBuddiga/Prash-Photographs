---
interface Props {
	src: string;
	alt: string;
	index: number;
}

// Fixed: Explicitly typed to ensure Astro passes properties down cleanly
const { src, alt, index } = Astro.props as Props;
---

<div
	role="button"
	tabindex="0"
	aria-label={`View photo ${index + 1}`}
	data-lightbox-trigger
	data-index={index}
	class="group relative block h-full w-full cursor-zoom-in overflow-hidden rounded-xl ring-1 ring-white/10 transition-all duration-500 hover:ring-white/30"
>
	<img
		src={src}
		alt={alt}
		loading="lazy"
		decoding="async"
		class="block w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
	/>
	<div class="pointer-events-none absolute inset-0 rounded-xl shadow-[inset_0_0_0_0_rgba(0,0,0,0)] transition-shadow duration-500 group-hover:shadow-[0_20px_50px_15px_rgba(0,0,0,0.5)]"></div>
	<div class="pointer-events-none absolute inset-0 rounded-xl bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
</div>
