---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/work', label: 'Work' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---

<header
	id="site-header"
	class="site-header fixed top-0 left-0 right-0 z-50 w-full transition-[background-color,backdrop-filter] duration-300"
>
	<div class="mx-auto flex w-full max-w-7xl items-center justify-between px-8 py-6 md:px-16">
		<a href="/" class="font-display text-xl tracking-wide text-white">Prash Photographs</a>
		<nav aria-label="Main">
			<ul class="flex list-none gap-8 md:gap-10">
				{navLinks.map(({ href, label }) => (
					<li>
						<a href={href} class="nav-link">{label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');

	if (header) {
		const onScroll = () => {
			header.classList.toggle('scrolled', window.scrollY > 50);
		};

		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	@reference "../styles/global.css";

	.site-header.scrolled {
		@apply bg-black/40 backdrop-blur-md;
	}

	.nav-link {
		@apply relative inline-block text-xs uppercase tracking-widest text-white/75 no-underline;
	}

	.nav-link::after {
		content: '';
		@apply absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-white transition-transform duration-300 ease-out;
	}

	.nav-link:hover::after {
		@apply scale-x-100;
	}
</style>
