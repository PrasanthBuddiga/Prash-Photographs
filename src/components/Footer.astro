---
const year = new Date().getFullYear();
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/work', label: 'Work' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
const socialLinks = [
	{ href: 'https://www.instagram.com/prash_photographs', label: 'Instagram', target: '_blank', rel: 'noopener noreferrer' },
	{ href: 'mailto:your-email@domain.com', label: 'Email' },
];
---

<footer class="border-t border-white/10 bg-[#0a0a0a] px-8 py-16 md:px-16">
	<div class="mx-auto max-w-7xl grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-4 md:gap-16">
		
		<!-- Left Side: Clean Branding & Dynamic Year -->
		<div class="sm:col-span-2">
			<p class="font-display text-base tracking-wide text-white">
				Prash
			</p>
			<p class="mt-4 text-xs tracking-wider uppercase text-white/40">
				&copy; {year} All rights reserved
			</p>
		</div>

		<!-- Navigation Links Loop -->
		<nav aria-label="Footer Navigation">
			<p class="text-xs font-medium uppercase tracking-wider text-white/30 mb-4">Explore</p>
			<ul class="flex flex-col gap-3 list-none p-0 m-0">
				{navLinks.map(({ href, label }) => (
					<li>
						<a href={href} class="footer-link">{label}</a>
					</li>
				))}
			</ul>
		</nav>

		<!-- Social Links Loop -->
		<nav aria-label="Social Links">
			<p class="text-xs font-medium uppercase tracking-wider text-white/30 mb-4">Connect</p>
			<ul class="flex flex-col gap-3 list-none p-0 m-0">
				{socialLinks.map(({ href, label, target, rel }) => (
					<li>
						<a href={href} class="footer-link" target={target} rel={rel}>{label}</a>
					</li>
				))}
			</ul>
		</nav>
		
	</div>
</footer>

<style>
	@reference "../styles/global.css";
	.footer-link {
		@apply text-sm text-white/60 no-underline transition-colors duration-200 hover:text-white;
	}
</style>
