---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About — Prash Photographs">
	<Header />
	<main id="main">
		<section class="mx-auto max-w-7xl px-8 pb-24 pt-32 md:px-16">
			<div class="grid gap-12 md:grid-cols-2 md:gap-20">
				<div>
					<img
						src="/images/prasanth.jpg""
						alt="Prash, photographer"
						class="w-full rounded-xl object-cover"
					/>
				</div>
				<div class="flex flex-col justify-center">
					<h1 class="font-display text-4xl font-bold text-white md:text-5xl">Prasanth Buddiga</h1>
                    <p class="mt-4 text-lg font-bold leading-relaxed text-white/90">
						I’m a photographer drawn to moments that feel honest, intentional, and quietly cinematic.
                    </p>
					<p class="mt-6 text-lg leading-relaxed text-white/70">
						Whether it is the emotion of a wedding, the character of a person, the atmosphere of an unfamiliar place, or an image built entirely from an idea, I’m interested in photographs that make you pause and feel something.
					</p>
					<p class="mt-4 text-lg leading-relaxed text-white/70">
						I’m particularly drawn to natural light, thoughtful composition, authentic expressions, and the small details that often carry the most meaning. I enjoy taking the time to observe a scene, find the right perspective, and create an image that feels both visually refined and true to the moment.
					</p>
					<p class="mt-4 text-lg leading-relaxed text-white/70">
						<span class="text-white/90">Weddings & Portraits:</span> Centered on preserving genuine emotion while creating photographs with a sense of elegance and presence. <br/>
                        <span class="text-white/90">Travel & Street:</span> A search for fleeting interactions, distinctive light, architecture, culture, and unexpected moments.<br/>
                        <span class="text-white/90">Conceptual Work:</span> Stepping beyond observation to create images driven by mood, symbolism, and imagination.
					</p>
                    <p class="mt-4 text-lg leading-relaxed font-bold text-white/70">
						At the heart of it all, I see photography as a way of not just recording what was there, but interpreting how it felt.
                    </p>

						<a href="/contact"
						class="mt-8 inline-block w-fit border border-white/20 px-8 py-3 text-sm uppercase tracking-widest text-white transition-colors hover:border-white hover:bg-white hover:text-black"
					>
						Get in touch
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
