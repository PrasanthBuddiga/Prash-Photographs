<BaseLayout title="Travel & Street — Prash Photographs">
	<Header />
	<main id="main">
		<section class="mx-auto max-w-7xl px-8 pb-8 pt-32 md:px-16">
			<h1 class="font-display text-4xl font-bold text-white md:text-6xl">Travel &amp; Street</h1>
