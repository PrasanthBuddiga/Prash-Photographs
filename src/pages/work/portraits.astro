---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';

const images = [
	{ src: '/images/portraits/comm0.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm1.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm2.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm3.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm4.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm5.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm6.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm7.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm8.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm9.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm10.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm11.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm12.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm13.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm14.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm15.jpg', alt: 'Wedding and portrait photograph' },
	{ src: '/images/portraits/comm16.jpg', alt: 'Wedding and portrait photograph' },
];
---

<BaseLayout title="Weddings & Portraits — Prash Photographs">
	<Header />
	<main id="main">
		<section class="mx-auto max-w-7xl px-8 pb-8 pt-32 md:px-16">
			<h1 class="font-display text-4xl font-bold text-white md:text-6xl">Weddings &amp; Portraits</h1>
			<p class="mt-4 max-w-xl text-white/70">Weddings, pre-wedding, and maternity stories.</p>
		</section>
		<Gallery images={images} folder="portraits" />
	</main>
	<Footer />
</BaseLayout>