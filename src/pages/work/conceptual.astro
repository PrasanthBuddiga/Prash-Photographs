---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';

const images = Array.from({ length: 19 }, (_, i) => ({
	src: `/images/conceptual/theme${i + 1}.jpg`,
	alt: 'Conceptual photograph',
}));
---

<BaseLayout title="Conceptual — Prash Photographs">
	<Header />
	<main id="main">
		<section class="mx-auto max-w-7xl px-8 pb-8 pt-32 md:px-16">
			<h1 class="font-display text-4xl font-bold text-white md:text-6xl">Conceptual</h1>
			<p class="mt-4 max-w-xl text-white/70">Styled, story-driven shoots built around a single idea.</p>
		</section>
		<Gallery images={images} folder="conceptual" />
	</main>
	<Footer />
</BaseLayout>