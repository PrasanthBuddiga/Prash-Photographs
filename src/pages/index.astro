---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroMarquee from '../components/HeroMarquee.astro';
---

<BaseLayout title="Prash Photographs">
	<Header />
	<main id="main">
		<section class="relative overflow-hidden">
	<HeroMarquee />

	<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/40"></div>

	<div class="pointer-events-none absolute inset-0 flex flex-col justify-end px-8 py-16 md:px-16 md:py-24">
		<div class="mx-auto w-full max-w-7xl">
			<h1 class="font-display text-5xl font-bold leading-tight tracking-tight text-white md:text-7xl">
				Hi, I'm Prasanth Buddiga.
			</h1>
			<p class="mt-4 max-w-xl text-base font-light tracking-wide text-white/80 md:text-lg">
				Documenting people, places, and the spaces in between.
			</p>
		</div>
	</div>
</section>
	</main>
	<Footer />
</BaseLayout>